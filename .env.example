# Quant Agent — environment configuration
# Copy this file to `.env` and fill in your secrets. `.env` is gitignored.

# FRED API key — free, ~30s signup at https://fred.stlouisfed.org/
# Required for risk-free rate (DGS3MO), CPI, and SOFR series.
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR (Smart Money layer: insider Form 4 + 13F) — free, no key required.
# SEC asks for a contact identity ("Name email") on every request. Optional:
# if unset, the app falls back to the project owner's contact.
# EDGAR_IDENTITY=Your Name your.email@example.com

# Supabase sink (optional) — write run results to the web dashboard's database.
# URL is public and has a default in code; the SERVICE ROLE key is SECRET (it
# bypasses Row Level Security). Get it from Supabase → Settings → API →
# service_role. If SUPABASE_SERVICE_KEY is unset, DB writes are skipped.
# SUPABASE_URL=https://fsvnarocfingywjmoevs.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Optional: override the local parquet cache directory.
# QUANT_AGENT_CACHE_DIR=data/cache

# Optional: log level (TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR).
# QUANT_AGENT_LOG_LEVEL=INFO
